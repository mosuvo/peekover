{
  "name": "peekover",
  "version": "0.0.0",
  "description": "Free, open-source browser extension that renders raw markdown into beautiful, private reading. Zero network by default.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "sbom": "tsx scripts/generate-sbom.ts",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "perf": "tsx scripts/perf-first-paint.ts",
    "perf:folder": "tsx scripts/perf-folder-tree.ts",
    "perf:toc": "tsx scripts/perf-toc.ts",
    "perf:flash": "tsx scripts/perf-theme-flash.ts",
    "perf:watch": "tsx scripts/perf-watch.ts",
    "perf:snapshot-capture": "tsx scripts/perf-snapshot-capture.ts",
    "perf:diff": "tsx scripts/perf-diff.ts",
    "lint": "eslint . && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "shiki": "4.4.3"
  }
}
