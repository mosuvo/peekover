{
  "name": "peekover",
  "version": "0.0.0",
  "description": "Free, open-source browser extension that renders raw markdown into beautiful, private reading. Zero network by default.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
